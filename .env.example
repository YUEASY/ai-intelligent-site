JWT_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_TENANT_ID=00000000-0000-0000-0000-000000000001
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-this-password
BOOTSTRAP_DEMO_DATA=true
SHOPIFY_CLIENT_ID=replace-with-shopify-client-id
SHOPIFY_CLIENT_SECRET=replace-with-shopify-client-secret
SHOPIFY_REDIRECT_URI=https://your-domain.example/api/v1/shopify/oauth/callback
SHOPIFY_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
